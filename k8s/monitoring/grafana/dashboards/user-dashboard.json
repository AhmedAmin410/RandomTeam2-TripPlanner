{
  "title": "User Service Dashboard",
  "uid": "user-service-dashboard",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "tags": ["tripplanning", "user-service"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [

    {
      "id": 1,
      "title": "Error Rate (errors/min)",
      "description": "Count of ERROR-level log lines from user-service per minute. Spike detection — sudden increase means something is wrong.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({app=\"tripplanning\", service=\"user-service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2 }
        }
      }
    },

    {
      "id": 2,
      "title": "Feign Call Outcomes (Success vs Failure)",
      "description": "Successful Feign calls vs FeignException catches to itinerary-service and booking-service. Detect when downstream services are degraded.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"tripplanning\", service=\"user-service\"} |= \"returned successfully\" [5m]))",
          "legendFormat": "Feign successes",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({app=\"tripplanning\", service=\"user-service\"} |= \"Feign call to\" |= \"failed\" [5m]))",
          "legendFormat": "Feign failures",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Feign failures" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Feign successes" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },

    {
      "id": 3,
      "title": "Slow Operation Warnings",
      "description": "Log lines where an operation exceeded the slow-threshold (> 1000ms). Useful for detecting when S1-F6 top-travelers Feign fan-out is degraded.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "count_over_time({app=\"tripplanning\", service=\"user-service\", level=\"WARN\"} |= \"Slow\" [5m])",
          "legendFormat": "slow ops/5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "custom": { "lineWidth": 2 }
        }
      }
    },

    {
      "id": 4,
      "title": "HTTP Request Rate (req/sec)",
      "description": "Requests per second per endpoint on user-service from Prometheus.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"user-service\"}[5m]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "HTTP Latency Percentiles (P50 / P95 / P99)",
      "description": "Latency percentiles for all user-service endpoints. High P99 on /api/users/{id}/trip-summary indicates slow Feign calls to itinerary-service.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m])))",
          "legendFormat": "P50 {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m])))",
          "legendFormat": "P95 {{uri}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"user-service\"}[5m])))",
          "legendFormat": "P99 {{uri}}",
          "refId": "C"
        }
      ]
    },

    {
      "id": 6,
      "title": "JVM Heap Usage (MB)",
      "description": "JVM heap used vs committed for user-service. Watch for steady growth indicating a memory leak.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"user-service\", area=\"heap\"} / 1048576",
          "legendFormat": "heap used (MB)",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{job=\"user-service\", area=\"heap\"} / 1048576",
          "legendFormat": "heap committed (MB)",
          "refId": "B"
        }
      ]
    }

  ],

  "templating": { "list": [] },
  "annotations": { "list": [] }
}
