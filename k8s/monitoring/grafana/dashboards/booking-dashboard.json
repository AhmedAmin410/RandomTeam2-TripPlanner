{
  "uid": "booking-service-m3",
  "title": "Trip Planning - Booking Service M3",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "editable": true,
  "tags": [
    "tripplanning",
    "booking-service",
    "m3",
    "saga"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Up",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"booking-service\"}",
          "legendFormat": "booking-service"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"booking-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP P95 Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"booking-service\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 4xx and 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status, uri) (rate(http_server_requests_seconds_count{job=\"booking-service\", status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{status}} {{uri}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Settlement Endpoint Outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(http_server_requests_seconds_count{job=\"booking-service\", uri=\"/api/bookings/settlement/process\"}[15m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RabbitMQ Saga Listener Throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(spring_rabbitmq_listener_seconds_count{job=\"booking-service\"}[5m]))",
          "legendFormat": "messages/s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Hikari Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"booking-service\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle{job=\"booking-service\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_max{job=\"booking-service\"}",
          "legendFormat": "max"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM Heap Used",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"booking-service\", area=\"heap\"})",
          "legendFormat": "heap used"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{job=\"booking-service\", area=\"heap\"})",
          "legendFormat": "heap committed"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Error Rate (LogQL)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "count_over_time({app=\"tripplanning\", service=\"booking-service\", level=\"ERROR\"} | json [1m])",
          "legendFormat": "errors/min"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Settlement Audit Trail",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{app=\"tripplanning\", service=\"booking-service\"} | json | message =~ \".*settlement.*\"",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Slow Operations",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{app=\"tripplanning\", service=\"booking-service\"} | json | message =~ \".*Slow.*\"",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      }
    }
  ]
}
