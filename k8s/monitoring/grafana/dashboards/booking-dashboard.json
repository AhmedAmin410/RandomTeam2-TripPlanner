{
  "uid": "booking-service-m3",
  "title": "Trip Planning - Booking Service",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["tripplanning", "booking-service", "m3"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{job=\"booking-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP P95 Latency",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"booking-service\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hikari Active Connections",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"booking-service\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_max{job=\"booking-service\"}",
          "legendFormat": "max"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM Heap Used",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"booking-service\", area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    }
  ]
}
