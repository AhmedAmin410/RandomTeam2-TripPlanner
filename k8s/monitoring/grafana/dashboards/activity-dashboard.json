{
  "title": "Trip Planning - Activity Service S4",
  "uid": "activity-service-dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "editable": true,
  "tags": ["tripplanning", "activity-service", "s4"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Error Rate (errors/min)",
      "description": "Count of ERROR-level log lines from activity-service per minute.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({app=\"tripplanning\", service=\"activity-service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 2,
      "title": "Feign Call Outcomes (Success vs Failure)",
      "description": "Feign successes vs failures to itinerary-service from activity-service.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"tripplanning\", service=\"activity-service\"} |= \"returned successfully\" [5m]))",
          "legendFormat": "Feign successes",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({app=\"tripplanning\", service=\"activity-service\"} |= \"Feign call to\" |= \"failed\" [5m]))",
          "legendFormat": "Feign failures",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Feign failures" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Feign successes" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "RabbitMQ Event Audit (Published vs Consumed)",
      "description": "Activity events published and itinerary events consumed by activity-service.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"tripplanning\", service=\"activity-service\"} |= \"Published\" [5m]))",
          "legendFormat": "Events published",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({app=\"tripplanning\", service=\"activity-service\"} |= \"Consuming\" [5m]))",
          "legendFormat": "Events consumed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Events published" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Events consumed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "Slow Operation Warnings",
      "description": "Log lines where an operation exceeded the slow threshold (> 1000ms).",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "count_over_time({app=\"tripplanning\", service=\"activity-service\", level=\"WARN\"} |= \"Slow\" [5m])",
          "legendFormat": "slow ops/5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Service Up (Prometheus)",
      "description": "Whether Prometheus can scrape activity-service /actuator/prometheus.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "up{job=\"activity-service\"}",
          "legendFormat": "activity-service",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "HTTP Request Rate",
      "description": "Requests per second per endpoint for activity-service.",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 16, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"activity-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Latency Percentiles (P50 / P95 / P99)",
      "description": "Latency percentiles for activity-service endpoints.",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 16, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"activity-service\"}[5m])))",
          "legendFormat": "P50 {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"activity-service\"}[5m])))",
          "legendFormat": "P95 {{uri}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"activity-service\"}[5m])))",
          "legendFormat": "P99 {{uri}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "JVM Heap Usage (MB)",
      "description": "JVM heap used vs committed for activity-service.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"activity-service\", area=\"heap\"} / 1048576",
          "legendFormat": "heap used (MB)",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{job=\"activity-service\", area=\"heap\"} / 1048576",
          "legendFormat": "heap committed (MB)",
          "refId": "B"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
